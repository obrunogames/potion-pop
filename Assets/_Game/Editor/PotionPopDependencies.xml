<?xml version="1.0" encoding="utf-8"?>
<!--
  Potion Pop! native dependencies, resolved by the External Dependency Manager for Unity (EDM4U, bundled with
  Google Mobile Ads). Used by the Services module:
    Android: Assets/_Game/Plugins/Android/GoogleSignInBridge.java (Credential Manager "Sign in with Google")
    iOS:     Assets/_Game/Plugins/iOS/SPGoogleSignIn.mm (GoogleSignIn SDK)
  Android needs the Custom Main Gradle Template (EDM4U patches it) and AndroidX (gradleTemplate.properties).
-->
<dependencies>
  <androidPackages>
    <repositories>
      <repository>https://maven.google.com</repository>
    </repositories>
    <androidPackage spec="androidx.credentials:credentials:1.3.0" />
    <androidPackage spec="androidx.credentials:credentials-play-services-auth:1.3.0" />
    <androidPackage spec="com.google.android.libraries.identity.googleid:googleid:1.1.1" />
  </androidPackages>
  <iosPods>
    <iosPod name="GoogleSignIn" version="~> 8.0" minTargetSdk="13.0" addToAllTargets="false" />
  </iosPods>
</dependencies>
